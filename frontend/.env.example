# Node.js API Gateway Target (Express Server)
# - Local development: use the Vercel dev-server proxy (defaults to /api/v1 -> http://localhost:5000)
# - Production (Vercel): set this to your deployed backend URL, e.g. https://your-backend.vercel.app/api/v1
VITE_API_BASE_URL=/api/v1

# Tile Server Settings (OpenStreetMap Default - No API Key Required)
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# 3GPP & EARTH Hardware Optimization Parameters
VITE_DEFAULT_SAFETY_HEADROOM_PCT=20
VITE_DEFAULT_BASE_STATION_P0_WATTS=250.0
VITE_DEFAULT_BASE_STATION_DELTA_P=4.2
VITE_DEFAULT_BASE_STATION_PMAX_WATTS=40.0
